#!/usr/bin/env bash
# Pre-commit hook: block commits containing secrets (via gitleaks).
# Bypass with `git commit --no-verify` if you're certain of a false positive.

if ! command -v gitleaks >/dev/null 2>&1; then
	echo "gitleaks not found in PATH — skipping secret scan (install: https://github.com/gitleaks/gitleaks)"
	exit 0
fi

gitleaks protect --staged --verbose --redact --no-banner
exit_code=$?

if [ $exit_code -ne 0 ]; then
	echo ""
	echo "🚫 gitleaks detected a potential secret in your staged changes."
	echo "   Fix it, or if this is a false positive, commit with --no-verify."
	exit 1
fi

exit 0
